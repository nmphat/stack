# Hindsight -- AI memory engine
# Copy to .env and fill in your values.

# LLM Provider
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=your-llm-api-key
HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini

# MCP Server
HINDSIGHT_MCP_ENABLED=true
HINDSIGHT_MCP_PORT=8890

# Telemetry
HINDSIGHT_TELEMETRY=false

# Authentication
HINDSIGHT_API_TENANT_EXTENSION=true
# Generate: openssl rand -base64 32
HINDSIGHT_API_TENANT_API_KEY=your-tenant-api-key
HINDSIGHT_API_MCP_AUTH_TOKEN=your-mcp-auth-token
HINDSIGHT_CP_ACCESS_KEY=hs_cp_your-access-key
HINDSIGHT_CP_DATAPLANE_API_KEY=your-tenant-api-key
